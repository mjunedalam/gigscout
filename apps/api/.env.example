# Copy to .env and adjust. Every setting in src/gigscout/config.py can be set as GIGSCOUT_<NAME>.
GIGSCOUT_LLM_PROVIDER=ollama          # or "none" for heuristic-only mode
GIGSCOUT_LLM_MODEL=qwen3:8b
GIGSCOUT_OLLAMA_BASE_URL=http://localhost:11434
GIGSCOUT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GIGSCOUT_MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db
GIGSCOUT_MAX_LEAD_AGE_DAYS=14
GIGSCOUT_MIN_GOOD_MATCHES=5
GIGSCOUT_GOOD_MATCH_THRESHOLD=0.6
# Extra RSS/Atom feeds, e.g. RFP/tender portals (JSON list), and the lead kind they carry
# GIGSCOUT_RSS_FEEDS=["https://example.com/tenders.rss"]
# GIGSCOUT_RSS_FEEDS_KIND=project
GIGSCOUT_USER_AGENT=gigscout/0.2 (agency lead scout; contact: sales@your-agency.example)

# Inbound leads from Google Ads lead forms. Use a long random value and paste the same key into
# Google Ads (lead form → Lead delivery → Webhook key). Leave unset to disable the webhook.
# GIGSCOUT_GOOGLE_ADS_WEBHOOK_KEY=change-me-to-a-long-random-string

# Multi-agent team guardrails
GIGSCOUT_TEAM_MAX_SEARCHES=12
GIGSCOUT_SHORTLIST_SIZE=10
