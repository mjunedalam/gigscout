# Copy to .env and adjust. Every setting in src/gigscout/config.py can be set as GIGSCOUT_<NAME>.
GIGSCOUT_LLM_PROVIDER=ollama          # or "none" for heuristic-only mode
GIGSCOUT_LLM_MODEL=qwen3:8b
GIGSCOUT_OLLAMA_BASE_URL=http://localhost:11434
GIGSCOUT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GIGSCOUT_MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db
GIGSCOUT_MAX_LEAD_AGE_DAYS=14
GIGSCOUT_MIN_GOOD_MATCHES=5
GIGSCOUT_GOOD_MATCH_THRESHOLD=0.6
# Extra RSS/Atom feeds, e.g. RFP/tender portals (JSON list), and the lead kind they carry
# GIGSCOUT_RSS_FEEDS=["https://example.com/tenders.rss"]
# GIGSCOUT_RSS_FEEDS_KIND=project
GIGSCOUT_USER_AGENT=gigscout/0.2 (agency lead scout; contact: sales@your-agency.example)

# Inbound leads from Google Ads lead forms. Use a long random value and paste the same key into
# Google Ads (lead form → Lead delivery → Webhook key). Leave unset to disable the webhook.
# GIGSCOUT_GOOGLE_ADS_WEBHOOK_KEY=change-me-to-a-long-random-string

# Multi-agent team guardrails
GIGSCOUT_TEAM_MAX_SEARCHES=12
GIGSCOUT_SHORTLIST_SIZE=10

# Email for the daily digest and lead outreach (Gmail/Google Workspace: smtp.gmail.com + an app password;
# Outlook/Microsoft 365: smtp.office365.com). Leave the host empty to keep email off.
# GIGSCOUT_SMTP_HOST=smtp.gmail.com
# GIGSCOUT_SMTP_PORT=587
# GIGSCOUT_SMTP_USER=you@your-company.com
# GIGSCOUT_SMTP_PASSWORD=
# GIGSCOUT_SMTP_FROM=Your Company <you@your-company.com>

# Client replies, read from the same mailbox over IMAP (SSL) so the agents can sort them and draft answers.
# Gmail: imap.gmail.com + an app password. Leave the host empty to keep it off (replies can be logged by hand).
# GIGSCOUT_IMAP_HOST=imap.gmail.com
# GIGSCOUT_IMAP_USER=you@your-company.com
# GIGSCOUT_IMAP_PASSWORD=
# GIGSCOUT_IMAP_FOLDER=INBOX
# GIGSCOUT_IMAP_POLL_MINUTES=10

# CRM sync: push leads as deals. HubSpot private-app token (scope crm.objects.deals.write),
# Pipedrive personal API token (Settings > Personal preferences > API).
# GIGSCOUT_HUBSPOT_TOKEN=
# GIGSCOUT_PIPEDRIVE_TOKEN=

# Public tenders: UK Contracts Finder, Find a Tender and EU TED are built in (no key).
# US federal tenders (SAM.gov) need a free key from https://api.data.gov/signup
# GIGSCOUT_SAM_GOV_API_KEY=

# Funding signals: US companies that just raised money (SEC Form D). The SEC asks automated clients to give a
# contact email in the User-Agent; set yours to turn this source on.
# GIGSCOUT_SEC_CONTACT_EMAIL=you@your-agency.com

# Upwork (official API): an approved key from https://www.upwork.com/developer/keys/apply. Register the callback
# http://localhost:5173/api/admin/upwork/callback on the key, then connect from Admin > Connectors.
# GIGSCOUT_UPWORK_CLIENT_ID=
# GIGSCOUT_UPWORK_CLIENT_SECRET=

# Inbound forms. Your own website: point the contact form (method="post") at /webhooks/form/<this key>.
# A hidden field named website_url catches bots. Typeform: the secret on the form's webhook (/webhooks/typeform).
# Meta lead ads: app secret, a verify token you choose, and a page token with leads_retrieval (/webhooks/meta).
# GIGSCOUT_WEBSITE_FORM_KEY=change-me-to-a-long-random-string
# GIGSCOUT_TYPEFORM_WEBHOOK_SECRET=
# GIGSCOUT_META_APP_SECRET=
# GIGSCOUT_META_VERIFY_TOKEN=
# GIGSCOUT_META_PAGE_ACCESS_TOKEN=

# Cloudflare Turnstile bot check on the website form (Cloudflare dashboard > Turnstile > Add widget).
# With the secret set, website form submissions need a passed check; the site key is public (used in the snippet).
# GIGSCOUT_TURNSTILE_SECRET_KEY=
# GIGSCOUT_TURNSTILE_SITE_KEY=

# Stripe billing (off until the secret key, webhook secret and at least one price are set: a self-hosted install has
# no limits). Create two monthly prices in Stripe, add a webhook to https://<your domain>/webhooks/stripe for
# checkout.session.completed, customer.subscription.* and invoice.paid / invoice.payment_failed.
# GIGSCOUT_STRIPE_SECRET_KEY=
# GIGSCOUT_STRIPE_WEBHOOK_SECRET=
# GIGSCOUT_STRIPE_PRICE_STARTER=price_...
# GIGSCOUT_STRIPE_PRICE_GROWTH=price_...
# GIGSCOUT_PUBLIC_URL=https://leads.youragency.com
# Workspaces that never pay (the operator's own), as a JSON list:
# GIGSCOUT_BILLING_EXEMPT_WORKSPACE_IDS=[1]

# Cloud AI (optional): use Claude instead of the local Ollama model. Runs get much faster and judgement sharper;
# lead text and the company profile go to Anthropic's API (contact details never do), billed per use.
# GIGSCOUT_LLM_PROVIDER=anthropic
# GIGSCOUT_ANTHROPIC_API_KEY=
# GIGSCOUT_ANTHROPIC_MODEL=claude-sonnet-5-5   # or claude-haiku-5-5: cheaper and faster, a little less sharp
