# docker-compose settings (copy to .env in the repository root; it is gitignored). App settings and secrets go in
# apps/api/.env (see apps/api/.env.example).

# Required: the database password (any long random string).
POSTGRES_PASSWORD=

# Your domain, e.g. leads.youragency.com (point its DNS at this server first). Caddy gets the HTTPS certificate.
# "localhost" uses a local certificate (browsers will warn): fine for a trial.
GIGSCOUT_SITE_ADDRESS=localhost

# Optional: Ollama elsewhere (default: the "llm" compose profile's container).
# GIGSCOUT_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional: backups (kept in ./backups).
# BACKUP_KEEP_DAYS=14
# BACKUP_HOUR_UTC=2
